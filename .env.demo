# Demo build only (`npm run build:demo`). Safe to commit — there are no secrets
# here by design: the demo ships with no database, no API keys and no service
# credentials of any kind. See src/demo/README.md.

VITE_DEMO_MODE=1

# The access code on the demo site's front door. Client-side only, so treat it as
# a "not for casual visitors" sign, not a security control. Must match the CODE
# constant in demo-site/index.html.
VITE_DEMO_PASSWORD=resound2026

# Clerk is aliased away entirely in this build, so no key is needed. Present only
# because the production entry point reads it before the demo branch is taken.
VITE_CLERK_PUBLISHABLE_KEY=demo-not-used
